# ---------------------------------------------------------------------------
# GitFolio — copy to `.env` (repo root) and adjust.
# `docker compose` reads this file; the backend also reads it directly.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=GitFolio API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
AUTO_CREATE_TABLES=true

# Comma-separated list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=gitfolio
POSTGRES_PASSWORD=gitfolio
POSTGRES_DB=gitfolio
POSTGRES_PORT=5432
# Consumed by the backend (note the explicit +psycopg driver).
DATABASE_URL=postgresql+psycopg://gitfolio:gitfolio@localhost:5432/gitfolio

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Ollama (local Llama 3.2) ---------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=10m
AI_ENABLED=true
ENABLE_BACKGROUND_AI=true

# --- ChromaDB (vector store) ----------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_AUTH_TOKEN=
CHROMA_ENABLED=true

# --- Retrieval tuning ------------------------------------------------------
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=14000
CHUNK_MAX_LINES=120
CHUNK_MIN_LINES=3
EMBED_BATCH_SIZE=32

# --- Storage / limits ------------------------------------------------------
# Where Git object databases live (inside the container this is /data/repos).
STORAGE_PATH=/data/repos
MAX_FILE_BYTES=524288
MAX_PUSH_FILES=2000

# --- Frontend (Next.js) ----------------------------------------------------
# In `frontend/.env.local`
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_NAME=GitFolio
