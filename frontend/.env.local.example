# ---------------------------------------------------------------------------
# GitFolio frontend — copy to `frontend/.env.local`
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend INCLUDING the /api prefix.
#   Local development : http://localhost:8000/api
#   Deployed backend  : https://gitfolio-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Shown in the navbar / page titles.
NEXT_PUBLIC_SITE_NAME=GitFolio

# Optional: the public URL of this deployment (used for absolute links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
